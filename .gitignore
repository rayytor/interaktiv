activities/*
!activities/books/
!activities/.gitkeep

# Temporary test / debug screenshots
dashboard_*.png

# Node / npm
node_modules/
npm-debug.log*

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
