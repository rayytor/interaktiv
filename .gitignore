# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.bak

# Virtual environments
.venv/
venv/
env/

# Logs
*.log
server.log

# Large binaries & PDFs (textbooks are fetched dynamically via kitap_pdf_linkleri.txt)
*.pdf
books/*.pdf

# Build and distribution directories
dist/

# JIT-downloaded interactive activity cache (keep pre-baked books in activities/books/)
activities/*
!activities/books/
!activities/.gitkeep

# Temporary test / debug screenshots
dashboard_*.png

# Node / npm
node_modules/
npm-debug.log*

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Derived parse cache for detector fitting (rebuilt by tools/hotspot_extraction/train/cache.py)
.cache/

# Trace sidecars: a diagnostic the reader never loads, written only by scan.py --trace
activities/books/*/trace.json.gz

# Kitap Sunumlari: teacher slide decks fetched by tools/kitap_sunumlari/fetch_ispring.py
# (hundreds of MB of slide images). Only the root index is tracked.
kitap_sunumlari/*
!kitap_sunumlari/index.json
