# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.bak

# Virtual environments
.venv/
venv/
env/

# Logs
*.log
server.log

# Large binaries & PDFs (textbooks are fetched dynamically via kitap_pdf_linkleri.txt)
*.pdf
books/*.pdf

# Build and distribution directories (the board bundle is built under dist/)
dist/

# JIT-downloaded interactive activity cache (keep pre-baked books in activities/books/)
activities/*
!activities/books/
!activities/.gitkeep

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Derived parse cache for detector fitting (rebuilt by tools/hotspot_extraction/train/cache.py)
.cache/

# Trace sidecars: a diagnostic the reader never loads, written only by scan.py --trace
activities/books/*/trace.json.gz

# Kitap Sunumlari: teacher slide decks downloaded by the retired fetcher
# (tools/kitap_sunumlari/, removed; see git history). Local data only.
kitap_sunumlari/

# Claude Code agent worktrees (local scratch checkouts, never committed)
.claude/worktrees/

# Vision detector (tools/hotspot_extraction/vision/PLAN.md): training env and rendered pages, never committed
.venv-vision/
data/vision/

# Gemini free-tier API keys for the vision teacher (tools/hotspot_extraction/vision/teacher.py --route api); never committed
api.md
